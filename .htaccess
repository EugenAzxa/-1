# Герои Дня - настройки для хостинга (SpaceWeb / Reg.ru). Совместимо с Apache 2.2 и 2.4.
AddDefaultCharset UTF-8
DirectoryIndex index.html
AddType image/webp .webp
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.geroidnya.ru -> geroidnya.ru
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ http://%1%{REQUEST_URI} [R=301,L]

  # Включить ПОСЛЕ выпуска SSL-сертификата в Reg.ru (убрать # в трёх строках ниже):
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # убранные страницы
  RewriteRule ^presets(\.html)?/?$ / [R=301,L]

  # старая страница садов и школ
  RewriteRule ^schools(\.html)?/?$ /museums [R=301,L]

  # короткие адреса: /museums -> museums.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L]
</IfModule>

# Картинки кешируются на сутки; у каждой в адресе метка версии ?v=, поэтому
# заменённый файл всё равно приходит новым. HTML, стили и скрипты - всегда свежие.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# служебные файлы закрыты (синтаксис 2.4 и 2.2)
<FilesMatch "\.(py|md|json|log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
